{
  "name": "colombo-delivery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "study:install": "npm --prefix studies/colombo-road/viewer ci",
    "study:dev": "npm --prefix studies/colombo-road/viewer run dev",
    "study:test": "npm --prefix studies/colombo-road/viewer test",
    "study:build": "npm --prefix studies/colombo-road/viewer run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import tsx --test tests/road-slice.test.ts tests/bicycle*.test.ts tests/character*.test.ts tests/delivery-controller.test.ts tests/practice-minimap.test.ts tests/scenery-placement.test.ts"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
